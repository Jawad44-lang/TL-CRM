# Database — standard multi-host URI (preferred): NO DNS SRV lookup needed,
# so it works on every PC/network. Shard hosts + replicaSet taken from the
# Atlas cluster's DNS records. DB: weather_db
# (Even if this gets changed back to mongodb+srv://, db.js auto-converts it.)
MONGO_URI=mongodb://eventsphere:tlcrm1408@ac-nqmlahn-shard-00-00.qskzef6.mongodb.net:27017,ac-nqmlahn-shard-00-01.qskzef6.mongodb.net:27017,ac-nqmlahn-shard-00-02.qskzef6.mongodb.net:27017/weather_db?tls=true&replicaSet=atlas-cjqyqh-shard-0&authSource=admin&retryWrites=true&w=majority
JWT_SECRET=messaging-crm-demo-secret-change-in-production
# NOTE: Port 5050 (not 5000) — 5000 is commonly grabbed by other apps
# (Python/ML services, .NET, macOS AirPlay). Frontend vite proxy targets 5050.
PORT=5050
CLIENT_URL=http://localhost:5173
DEMO_MODE=true